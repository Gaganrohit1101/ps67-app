# npm run dev supplies local values. These are for public testnet deployment.
MODE=testnet
CHAIN_ID=11155111
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com
CONTRACT_ADDRESS=
DEPLOYMENT_BLOCK=0
EXPLORER_URL=https://sepolia.etherscan.io
IPFS_API=http://127.0.0.1:5001/api/v0
# For remote IPFS in production: set PINATA_JWT or IPFS_API
PINATA_JWT=
PINATA_GATEWAY=gateway.pinata.cloud
FRONTEND_ORIGINS=http://127.0.0.1:8000,http://127.0.0.1:8001
AUTH_ORIGIN=http://127.0.0.1:5000
# DATA_DIR must be a persistent private directory when hosted.
