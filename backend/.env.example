# Copy this file to .env and fill it in.  .env is git-ignored: never commit it.

# ---- Blockchain (required) ------------------------------------------------
# Private key of a BURNER wallet made just for the hackathon (MetaMask:
# Account details -> Show private key). It needs a little test ETH/POL.
PRIVATE_KEY=0xyour_burner_wallet_private_key

# RPC for the network your contract is on. Public ones (or use Alchemy/Infura):
#   Ethereum Sepolia   https://ethereum-sepolia-rpc.publicnode.com
#   Base Sepolia       https://base-sepolia-rpc.publicnode.com
#   Polygon Amoy       https://polygon-amoy-bor-rpc.publicnode.com
#   Arbitrum Sepolia   https://arbitrum-sepolia-rpc.publicnode.com
#   OP Sepolia         https://optimism-sepolia-rpc.publicnode.com
RPC_URL=https://ethereum-sepolia-rpc.publicnode.com

# Address Remix printed when you deployed contracts/RecordRegistry.sol
CONTRACT_ADDRESS=0xYourDeployedContractAddress

# Block explorer for the same network (used to build transaction links)
#   https://sepolia.etherscan.io  https://sepolia.basescan.org
#   https://amoy.polygonscan.com  https://sepolia.arbiscan.io
#   https://sepolia-optimism.etherscan.io
EXPLORER_URL=https://sepolia.etherscan.io

# ---- Database ---------------------------------------------------------------
# Empty = a local SQLite file (fine on your laptop). When you deploy, paste a
# Postgres connection string from Neon or Supabase (Supabase: use the
# "Session pooler" string). Render's disk is wiped on restart, so a SQLite
# file there would lose its records.
DATABASE_URL=

# ---- Web --------------------------------------------------------------------
# Your frontend's URL once deployed (exact, no trailing slash). * = allow all.
FRONTEND_ORIGIN=*

# ---- AI (optional: leave API_KEY empty to use demo answers) -----------------
# Any OpenAI-compatible chat API works. Base URLs:
#   OpenAI      https://api.openai.com/v1
#   Groq        https://api.groq.com/openai/v1
#   Gemini      https://generativelanguage.googleapis.com/v1beta/openai
#   OpenRouter  https://openrouter.ai/api/v1
#   Anthropic   https://api.anthropic.com/v1
#   Ollama      http://localhost:11434/v1   (local, free)
# AI_MODEL = a model name from your provider's docs.
API_KEY=
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=
